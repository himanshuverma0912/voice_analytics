# ==========================================
# LLM gateway (LiteLLM or any OpenAI-compatible endpoint)
# ==========================================

# Required. No default -- the library refuses to start without it.
LLM_BASE_URL=https://10.216.70.62/DEV/litellm

# Optional fallback key. Callers may instead pass api_key= per request,
# which is how each consumer runs under their own credential.
LLM_API_KEY=

# Model used when the caller does not name one.
MODEL_NAME=gemini-2.5-flash

# Comma-separated allow-list of models able to accept audio input.
TRANSCRIPTION_MODEL_NAMES=gemini-2.5-flash,gemini-2.5-flash-transcription

# ==========================================
# PromptHub (KPI prompt registry)
# ==========================================

# Only needed when resolving KPI prompts for scoring. Prompts are fetched once
# per batch by the caller, never per call.
PROMPTHUB_BASE_URL=https://10.216.70.62/DEV/prompthub-service
PROMPTHUB_PROMPTS_PATH=/extenal/get-all-prompts
PROMPTHUB_TIMEOUT_SECONDS=60

# Key for a *default* use case, consulted when the active one has no prompt for
# a KPI -- or no base prompt at all. The originating service called this
# DEFAULT_USECASE_LITELLM_KEY and hardcoded it in source. Optional: leave it
# unset and a KPI with no prompt of its own is skipped and reported.
PROMPTHUB_DEFAULT_LITELLM_KEY=

# ==========================================
# Anonymization service
# ==========================================

# Endpoint that strips personal information from text. No default on purpose:
# a wrong URL would silently skip a compliance control. Only required when
# using `anonymize()` or `transcribe --anonymize`.
ANONYMIZATION_URL=https://10.216.70.62/DEV/platform-auxiliary-services/api/v1/internal/anonymize-messages

# Per-request timeout in seconds.
ANONYMIZATION_TIMEOUT_SECONDS=30

# ==========================================
# SFTP source -- only needed by the `transfer` command
# ==========================================

# Where the recordings come from.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=

# One of these two. A key is preferred; the password exists because some
# corporate SFTP servers still offer nothing else.
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=

# REQUIRED. A known_hosts file naming the server's host key. Without it there
# is nothing to prove the host answering is the host expected, and the session
# carries both the credential and the recordings -- so the transfer refuses to
# run rather than trusting whatever answers. Generate it with:
#   ssh-keyscan -p 22 sftp.internal > known_hosts
SFTP_KNOWN_HOSTS=

SFTP_TIMEOUT_SECONDS=60

# ==========================================
# HTTP behaviour
# ==========================================

# Verify the gateway's TLS certificate.
# In the corporate environment set this to True and point SSL_CA_BUNDLE at the
# internal CA -- the system trust store will not contain it, so True on its own
# fails the handshake. False suits local development against self-signed certs.
SSL_VERIFY=False

# Path to the corporate CA bundle (PEM). Setting it implies verification is on.
# In a container, mount it or bake it in, e.g. /etc/ssl/certs/corp-ca.pem
SSL_CA_BUNDLE=

# Retries the OpenAI SDK performs for transient failures. NOTE: this stacks
# with the library's own retry loop (3 attempts), so 3 here means up to 12
# gateway calls. Set to 0 to let the library's policy be the only one.
MAX_RETRIES=3

# Per-request timeout in seconds. Audio transcription is legitimately slow.
REQUEST_TIMEOUT_SECONDS=120
