# ==========================================
# LLM gateway (LiteLLM or any OpenAI-compatible endpoint)
# ==========================================

# Required. No default -- the library refuses to start without it.
LLM_BASE_URL=https://10.216.70.62/DEV/litellm

# Optional fallback key. Callers may instead pass api_key= per request,
# which is how each consumer runs under their own credential.
LLM_API_KEY=

# Model used when the caller does not name one.
MODEL_NAME=gemini-2.5-flash

# Comma-separated allow-list of models able to accept audio input.
TRANSCRIPTION_MODEL_NAMES=gemini-2.5-flash,gemini-2.5-flash-transcription

# ==========================================
# HTTP behaviour
# ==========================================

# Verify the gateway's TLS certificate.
# In the corporate environment set this to True and point SSL_CA_BUNDLE at the
# internal CA -- the system trust store will not contain it, so True on its own
# fails the handshake. False suits local development against self-signed certs.
SSL_VERIFY=False

# Path to the corporate CA bundle (PEM). Setting it implies verification is on.
# In a container, mount it or bake it in, e.g. /etc/ssl/certs/corp-ca.pem
SSL_CA_BUNDLE=

# Retries the OpenAI SDK performs for transient failures. NOTE: this stacks
# with the library's own retry loop (3 attempts), so 3 here means up to 12
# gateway calls. Set to 0 to let the library's policy be the only one.
MAX_RETRIES=3

# Per-request timeout in seconds. Audio transcription is legitimately slow.
REQUEST_TIMEOUT_SECONDS=120
